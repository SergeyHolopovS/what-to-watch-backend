# Скопируйте в .env и заполните. .env уже в .gitignore.

# Discord OAuth (Developer Portal -> Applications -> OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/auth/callback

# Postgres
POSTGRES_HOST=db
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=admin
EXTERNAL_DB_PORT=5432

# Приложение
CONTAINER_NAME=service
APP_PORT=8080
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
# dev = фейковые мультфильмы/сериалы сеются при старте. В prod поставьте prod.
SPRING_PROFILES_ACTIVE=dev

# Вайтлист: discordId через запятую, кто может войти. Пустой = никто.
AUTH_WHITELIST_DISCORD_IDS=

# Cookie с токенами. COOKIES_SECURE=true обязателен при работе по https.
COOKIES_SECURE=false
COOKIES_SAME_SITE=Lax

# JWT: сгенерировать свою пару ключей EC P-256 (base64 без PEM-заголовков)
#   openssl ecparam -name prime256v1 -genkey -noout -out ec_key.pem
#   openssl pkcs8 -topk8 -nocrypt -in ec_key.pem     # -> JWT_PRIVATE_KEY
#   openssl ec -in ec_key.pem -pubout                # -> JWT_PUBLIC_KEY
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=864000

# Периодичность чистки протухших refresh токенов, в часах
REFRESH_TOKEN_AUTODELETE_RATE=1
